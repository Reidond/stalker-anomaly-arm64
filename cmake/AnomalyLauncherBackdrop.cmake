# The launcher's backdrop picture, generated at configure time by tools/make_launcher_backdrop.sh into the build tree (gitignored) from the
# game's own main-menu art when the game data is present (ANOMALY_GAME_DIR, see AnomalyAppIcon.cmake); without it the launcher draws a
# plain gradient. The result goes into the global property ANOMALY_LAUNCHER_BACKDROP (the JPEG's path, empty when there is none).
include_guard(GLOBAL)
include(AnomalyAppIcon)

function(anomaly_generate_launcher_backdrop)
    set(out_dir "${CMAKE_BINARY_DIR}/launcher_backdrop")
    set(script "${PROJECT_SOURCE_DIR}/tools/make_launcher_backdrop.sh")
    set(archive "${ANOMALY_GAME_DIR}/db/textures/textures_ui.db0")
    set_property(GLOBAL PROPERTY ANOMALY_LAUNCHER_BACKDROP "")
    if(NOT EXISTS "${archive}")
        message(STATUS "launcher backdrop: plain gradient (no ${archive}); set ANOMALY_GAME_DIR to use the game's menu art")
        return()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${script}")
    file(SHA256 "${script}" script_hash)
    file(SIZE "${archive}" archive_size)
    file(TIMESTAMP "${archive}" archive_time)
    set(stamp "${archive} ${archive_size} ${archive_time}\n${script_hash}")
    set(stamp_file "${out_dir}.stamp")
    if(EXISTS "${stamp_file}" AND EXISTS "${out_dir}/launcher-backdrop.jpg")
        file(READ "${stamp_file}" previous)
        if(previous STREQUAL stamp)
            set(up_to_date TRUE)
        endif()
    endif()
    if(NOT up_to_date)
        execute_process(COMMAND "${script}" "${out_dir}" "${ANOMALY_GAME_DIR}"
            RESULT_VARIABLE result ERROR_VARIABLE errors OUTPUT_QUIET)
        if(NOT result EQUAL 0)
            file(REMOVE "${stamp_file}")
            string(STRIP "${errors}" errors)
            message(WARNING "launcher backdrop: tools/make_launcher_backdrop.sh failed (${errors}); the launcher gets a plain gradient.")
            return()
        endif()
        file(WRITE "${stamp_file}" "${stamp}")
    endif()
    set_property(GLOBAL PROPERTY ANOMALY_LAUNCHER_BACKDROP "${out_dir}/launcher-backdrop.jpg")
    message(STATUS "launcher backdrop: the game's menu art from ${ANOMALY_GAME_DIR}")
endfunction()

anomaly_generate_launcher_backdrop()
