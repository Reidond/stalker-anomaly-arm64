index 64320fd..5e9697d 100644
--- a/src/lj_mcode.h
+++ b/src/lj_mcode.h
@@ -8,6 +8,29 @@
 
 #include "lj_obj.h"
 
+/* TXM dual-mapped machine code (Apple devices where only a debugger can
+** authorize executable pages). The code area is mapped twice: an RX alias
+** (the address the CPU executes and LuaJIT records) and an RW alias at a
+** fixed distance (the only address code is written through). Every store
+** into machine code goes through LJ_MCW(). See lj_txm.c.
+*/
+#if defined(LUAJIT_TXM_DUALMAP) && LJ_TARGET_ARM64 && LJ_TARGET_POSIX
+#define LJ_TXM_DUALMAP	1
+#else
+#define LJ_TXM_DUALMAP	0
+#endif
+
+#if LJ_TXM_DUALMAP
+LJ_DATA ptrdiff_t lj_mcode_rwdelta;	/* RW alias minus RX address. */
+#define LJ_MCW(p)	((MCode *)((char *)(p) + lj_mcode_rwdelta))
+LJ_FUNC int lj_txm_mcode_ready(void);
+LJ_FUNC void *lj_txm_mcode_alloc(size_t sz);
+LJ_FUNC void lj_txm_mcode_free(void *p, size_t sz);
+LJ_FUNC int lj_txm_mcode_sync(void *start, void *end);
+#else
+#define LJ_MCW(p)	(p)
+#endif
+
 #if LJ_HASJIT || LJ_HASFFI
 LJ_FUNC void lj_mcode_sync(void *start, void *end);
 #endif
