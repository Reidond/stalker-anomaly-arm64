# xrGame: the game (AI, objects, UI, scripts). The project also compiles 58 files of src/xrServerEntities (server
# entities, object factory, script engine): xrServerEntities has no project of its own. Source list:
# src/xrGame/xrGame.vcxproj (the vs2022 copy lists nearly the same files). Opt-in: -DANOMALY_BUILD_XRGAME=ON (or
# ANOMALY_BUILD_ALL_MODULES). Owner: the xrgame-triage session (this file, stdafx.h, pch_script.h and the shared headers),
# shard sessions only edit their own sources. docs/ios-port/XRGAME-SHARDS.md is the manual.
#
# Layout: every source of the project belongs to exactly one shard (cmake/targets/xrgame_shards/<shard>.txt, generated by
# tools/xrgame_shards.py). Each shard is an OBJECT library `xrGame_<shard>` (dashes become underscores), so a shard session
# builds only its own files:
#
#     ninja -k 0 xrGame_ui                  # compile one shard, keep going after errors
#     ninja -k 0 xrGame_shards              # all shards, no archive
#     ninja xrGame                          # the full static library (archives the objects of all shards)
#
# `xrGame` is the same static library as before (one libxrGame.a); it takes the objects of the shard libraries.
#
# Precompiled header: every source starts with #include "stdafx.h" (or pch_script.h, which includes it), exactly what the
# MSVC project does with /Yu stdafx.h. The shard libraries share one PCH (ANOMALY_XRGAME_PCH, default ON). Configure a
# probe build with -DANOMALY_XRGAME_PCH=OFF: tools/xrgame_probe.py reruns compile commands with -fsyntax-only, and without
# the PCH an error in a shared header is reported by every translation unit that includes it, which is what the probe ranks.
#
# Multiplayer: the mp-stub shard holds the multiplayer game types, GameSpy, accounts, anti-cheat, MP screenshots and
# file transfer. They are not compiled for the Apple port (ANOMALY_XRGAME_MULTIPLAYER=OFF): the shard then builds only the
# sources listed in xrgame_shards/mp-stub-compiled.txt (the stubs for the entry points single-player code still calls, and
# any multiplayer file single-player turned out to need). Moving a file from "excluded" to "compiled" is one line in that file.
anomaly_module_begin(xrGame "game logic")

option(ANOMALY_XRGAME_PCH "Precompile xrGame/stdafx.h for the xrGame shard targets (-DANOMALY_XRGAME_PCH=OFF for the syntax probe)" ON)
option(ANOMALY_XRGAME_MULTIPLAYER "Compile the multiplayer / GameSpy / anti-cheat sources (the mp-stub shard) instead of its stubs" OFF)

set(XRGAME_SHARD_DIR "${CMAKE_CURRENT_LIST_DIR}/xrgame_shards")
set(XRGAME_SHARDS
    ai-monsters-a ai-monsters-b ai-core nav-alife script-entities ui objects-items objects-world core-physics mp-stub)
set(XRGAME_DEFAULT_SHARD core-physics)  # a source the shard lists do not know yet (a new file from an upstream merge)

anomaly_vcxproj_sources(xrgame_sources "${ANOMALY_SRC_DIR}/xrGame/xrGame.vcxproj")

# Reads xrgame_shards/<name>.txt (paths relative to src/, `#` comments allowed) into <out>; LOWER lower-cases the
# entries, for the case-insensitive match against the vcxproj spelling.
function(xrgame_read_list out name)
    cmake_parse_arguments(ARG "LOWER" "" "" ${ARGN})
    set(path "${XRGAME_SHARD_DIR}/${name}.txt")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(STRINGS "${path}" lines)
    list(FILTER lines EXCLUDE REGEX "^[ \t]*(#|$)")
    if(ARG_LOWER)
        string(TOLOWER "${lines}" lines)
    endif()
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

foreach(shard IN LISTS XRGAME_SHARDS)
    xrgame_read_list(xrgame_keys_${shard} ${shard} LOWER)
    set(xrgame_sources_${shard} "")
endforeach()
xrgame_read_list(xrgame_mp_compiled mp-stub-compiled)

set(xrgame_unassigned "")
foreach(src IN LISTS xrgame_sources)
    file(RELATIVE_PATH rel "${ANOMALY_SRC_DIR}" "${src}")
    string(TOLOWER "${rel}" key)
    set(owner "")
    foreach(shard IN LISTS XRGAME_SHARDS)
        list(FIND xrgame_keys_${shard} "${key}" idx)
        if(NOT idx EQUAL -1)
            set(owner ${shard})
            break()
        endif()
    endforeach()
    if(NOT owner)
        list(APPEND xrgame_unassigned "${rel}")
        set(owner ${XRGAME_DEFAULT_SHARD})
    endif()
    list(APPEND xrgame_sources_${owner} "${src}")
endforeach()
if(xrgame_unassigned)
    list(LENGTH xrgame_unassigned count)
    message(WARNING "xrGame: ${count} source(s) are in no shard list and went to ${XRGAME_DEFAULT_SHARD} "
        "(run tools/xrgame_shards.py): ${xrgame_unassigned}")
endif()

# Multiplayer exclusion: the mp-stub shard compiles its keep list instead of the multiplayer sources.
if(NOT ANOMALY_XRGAME_MULTIPLAYER)
    set(xrgame_sources_mp-stub "")
    foreach(rel IN LISTS xrgame_mp_compiled)
        if(NOT EXISTS "${ANOMALY_SRC_DIR}/${rel}")
            message(FATAL_ERROR "xrGame: ${rel} (mp-stub-compiled.txt) does not exist")
        endif()
        list(APPEND xrgame_sources_mp-stub "${ANOMALY_SRC_DIR}/${rel}")
    endforeach()
else()
    foreach(rel IN LISTS xrgame_mp_compiled)
        list(APPEND xrgame_sources_mp-stub "${ANOMALY_SRC_DIR}/${rel}")
    endforeach()
    list(REMOVE_DUPLICATES xrgame_sources_mp-stub)
endif()

set(xrgame_include_dirs
    "${ANOMALY_SRC_DIR}/xrGame"
    "${ANOMALY_SRC_DIR}/xrServerEntities"
    "${ANOMALY_SRC_DIR}/3rd party/imgui"
    "${ANOMALY_SRC_DIR}/3rd party/cximage"
)
# Diagnostics that only restate MSVC-isms the shards are not going to change (hundreds of hits each, no information).
# Left visible on purpose: -Wnonnull, -Wundefined-bool-conversion, -Wreturn-type, -Wpointer-to-int-cast, -Wformat-security
# (undefined behaviour or 64-bit truncation that MSVC compiled "as written").
set(xrgame_compile_options
    -Wno-unknown-warning-option         # -Wno-class-memaccess & co. in Anomaly::EngineConfig are GCC-only names
    -Wno-comment                        # `// ... \` and `/*` inside comments
    -Wno-explicit-specialization-storage-class   # `template <> static T f<true>()` inside a class (CWG 727)
    -Wno-inline-new-delete -Wno-implicit-exception-spec-mismatch
    -Wno-macro-redefined -Wno-builtin-macro-redefined -Wno-pragma-once-outside-header
    # `if (!this) return;` (operator_abstract_inline.h, script_game_object_use.cpp, GameObject.cpp) and `&ref == NULL`
    # (ai_location(), script exports) worked on MSVC; clang folds them to "false" unless null is declared valid.
    -fno-delete-null-pointer-checks
)
set(xrgame_link_targets luabind LuaJIT::luajit ode xrAPI xrCDB xrNetServer xrPhysics xrXMLParser)

# One OBJECT library per shard, configured like anomaly_add_module() configures a module.
set(xrgame_objects "")
set(xrgame_shard_targets "")
set(xrgame_pch_owner "")
foreach(shard IN LISTS XRGAME_SHARDS)
    string(REPLACE "-" "_" id "${shard}")
    set(tgt xrGame_${id})
    list(LENGTH xrgame_sources_${shard} count)
    message(STATUS "xrGame shard ${shard}: ${count} sources (target ${tgt})")
    if(count EQUAL 0)
        message(FATAL_ERROR "xrGame shard ${shard} has no sources")
    endif()
    add_library(${tgt} OBJECT ${xrgame_sources_${shard}})
    target_link_libraries(${tgt} PUBLIC Anomaly::EngineConfig)
    foreach(dep IN LISTS xrgame_link_targets)
        target_link_libraries(${tgt} PUBLIC "$<TARGET_NAME_IF_EXISTS:${dep}>")
    endforeach()
    target_include_directories(${tgt} PRIVATE ${xrgame_include_dirs})
    foreach(dir IN LISTS xrgame_include_dirs)
        # see anomaly_add_module(): "stdafx.h" must find xrGame's, not xrCore's
        target_compile_options(${tgt} PRIVATE "SHELL:-iquote \"${dir}\"")
    endforeach()
    target_compile_definitions(${tgt} PRIVATE XRGAME_EXPORTS)
    target_compile_options(${tgt} PRIVATE ${xrgame_compile_options})
    if(ANOMALY_XRGAME_PCH)
        if(NOT xrgame_pch_owner)
            target_precompile_headers(${tgt} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${ANOMALY_SRC_DIR}/xrGame/stdafx.h>")
            set(xrgame_pch_owner ${tgt})
        else()
            target_precompile_headers(${tgt} REUSE_FROM ${xrgame_pch_owner})
        endif()
    endif()
    set_target_properties(${tgt} PROPERTIES FOLDER "xrGame")
    list(APPEND xrgame_objects "$<TARGET_OBJECTS:${tgt}>")
    list(APPEND xrgame_shard_targets ${tgt})
endforeach()
add_custom_target(xrGame_shards DEPENDS ${xrgame_shard_targets})
set_target_properties(xrGame_shards PROPERTIES FOLDER "xrGame")

anomaly_add_module(xrGame
    SOURCES ${xrgame_objects}
    INCLUDE_DIRS ${xrgame_include_dirs}
    DEFINES XRGAME_EXPORTS
    LINK ${xrgame_link_targets}
)
set_target_properties(xrGame PROPERTIES LINKER_LANGUAGE CXX)
