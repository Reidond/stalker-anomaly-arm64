# Copy to deploy.local.env (untracked) and fill in. Read by scripts/*.sh.
# The hostname and bucket are deployment settings and stay out of the repository.

# Public hostname of the deployment; the zone must be active on your Cloudflare account.
ANOMALY_WEB_HOST=game.example.com

# R2 bucket holding data/ and bin/ (the publisher reads this name too).
ANOMALY_WEB_BUCKET=anomaly-web-data

# Optional: the cf executable. Pin one version; cf is a beta (see docs/web-port/HOSTING.md).
# CF_BIN=/path/to/cf
