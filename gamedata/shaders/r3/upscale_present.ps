#include "common.h"

// Render scale: the last pass of the 3D scene, a copy of the scene (or of what MetalFX made of it) into the back buffer.
// upscale_params.x is the sharpening (0: none), .yz the texel size of s_upscale_in.

Texture2D s_upscale_in;
uniform float4 upscale_params;

float4 main ( p_TL I ) : SV_Target
{
	float3 c = s_upscale_in.Sample( smp_rtlinear, I.Tex0 ).rgb;

	if (upscale_params.x > 0.0)
	{
		// contrast adaptive sharpening on the four neighbours: less where the neighbourhood is already near black or white
		float2 px = upscale_params.yz;
		float3 n = s_upscale_in.Sample( smp_rtlinear, I.Tex0 + float2(0, -px.y) ).rgb;
		float3 s = s_upscale_in.Sample( smp_rtlinear, I.Tex0 + float2(0,  px.y) ).rgb;
		float3 w = s_upscale_in.Sample( smp_rtlinear, I.Tex0 + float2(-px.x, 0) ).rgb;
		float3 e = s_upscale_in.Sample( smp_rtlinear, I.Tex0 + float2( px.x, 0) ).rgb;
		float3 mn = min( c, min( min( n, s ), min( w, e ) ) );
		float3 mx = max( c, max( max( n, s ), max( w, e ) ) );
		float3 amp = sqrt( saturate( min( mn, 1.0 - mx ) / max( mx, 0.0001 ) ) );
		float3 k = -amp * lerp( 0.125, 0.2, upscale_params.x );
		c = saturate( ( c + ( n + s + w + e ) * k ) / ( 1.0 + 4.0 * k ) );
	}

	return float4( c, 1.0 );
}
