--[[
	Crash-sweep driver (docs/ios-port/SANITIZERS.md, tools/sweep/).

	Inert unless the environment sets ANOMALY_SWEEP, e.g. ANOMALY_SWEEP=smoke (tools/sweep/run.sh does). axr_main calls
	on_game_start() of every script; this one then drives the game from actor_on_update: it spawns enemies and items,
	shoots, takes damage, uses medkits, opens the inventory, PDA, trade and talk dialogs, forces an emission, sleeps,
	changes level, saves, dies and reloads, and quits, logging "[sweep] ..." lines. Every step runs under pcall, so a Lua
	error of the driver is a "[sweep] FAIL" line and the run goes on; a crash of the engine is the finding.

	Plans (ANOMALY_SWEEP=<plan>): a plan is a list of phases. A phase ends by asking for a reload of a save or for the
	end of the run; the progress (plan name and next phase) lives in <appdata>/sweep_state.txt so it survives the reload
	(the Lua state is rebuilt on every load). Delete the file to start a plan over.

	Needs the engine's debug commands: start the app with -dbg (jump_to_level, g_god, run_string, ...). The driver itself
	only needs the Lua exports, not the console commands.
--]]

local plan_name = nil
local state_file = nil
local co = nil            -- the running phase (a coroutine resumed once per actor update)
local phase_index = 1
local started_at = 0

-- printf of _g only substitutes %s
local function say(fmt, ...)
	printf("[sweep] [t=%s f=%s] " .. fmt:gsub("%%d", "%%s"), time_global(), device().frame, ...)
	get_console():execute("flush") -- the engine log is buffered; a hung run would otherwise show nothing
end

-- progress file ---------------------------------------------------------------------------------------------------
local function state_path()
	if not state_file then
		state_file = getFS():update_path("$app_data_root$", "") .. "sweep_state.txt"
	end
	return state_file
end

local function read_state()
	local f = io.open(state_path(), "r")
	if not f then
		return nil, 1
	end
	local name, idx = f:read("*l"), tonumber(f:read("*l"))
	f:close()
	return name, idx or 1
end

local function write_state(name, idx)
	local f = io.open(state_path(), "w")
	if f then
		f:write(name, "\n", tostring(idx), "\n")
		f:close()
	end
end

-- helpers (usable from a phase, i.e. from inside the coroutine) -----------------------------------------------------
local function pause(ms)
	local t = time_global() + ms
	while time_global() < t do
		coroutine.yield()
	end
end

local function wait_for(what, timeout_ms, pred)
	local t = time_global() + timeout_ms
	while time_global() < t do
		local ok, res = pcall(pred)
		if ok and res then
			return true
		end
		coroutine.yield()
	end
	say("TIMEOUT waiting for %s", what)
	return false
end

local function try(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if ok then
		say("ok   %s", name)
	else
		say("FAIL %s: %s", name, tostring(err))
	end
	return ok, err
end

-- an assertion of the plan: "ok   check <name>" or "FAIL check <name>" (run.sh counts the FAILs)
local function check(name, cond, detail)
	if cond then
		say("ok   check %s", name)
	else
		say("FAIL check %s%s", name, detail and (" -- " .. detail) or "")
	end
	return cond and true or false
end

local function give(section, count, ammo)
	for _ = 1, count or 1 do
		if ammo then
			alife_create_item(section, db.actor, { ammo = ammo })
		else
			alife_create_item(section, db.actor)
		end
	end
end

-- a spot `dist` metres from the actor in direction `ang` (radians, 0 = +z), walkable
local function spot(dist, ang)
	local dir = vector():set(math.sin(ang), 0, math.cos(ang))
	local lvid = level.vertex_in_direction(db.actor:level_vertex_id(), dir, dist)
	return level.vertex_position(lvid), lvid
end

-- the transition spot of a level is next to its level changer; a fight there ends in a level change (autosave, disconnect)
local function move_inland(dist)
	local best, best_d = nil, 0
	for i = 0, 7 do
		local pos, lvid = spot(dist, i * 0.785)
		local d = db.actor:position():distance_to(pos)
		if d > best_d then
			best, best_d = pos, d
		end
	end
	if best then
		db.actor:set_actor_position(best)
		say("moved %s m inland", tostring(math.floor(best_d)))
	end
end

local function spawn_near(section, dist, ang)
	local pos, lvid = spot(dist, ang)
	local se = alife_create(section, pos, lvid, db.actor:game_vertex_id())
	say("spawn %s -> %s", section, se and tostring(se.id) or "nil")
	return se
end

local function god(on)
	get_console():execute("g_god " .. (on and "on" or "off"))
end

local function actor_hit(power, kind)
	god(false)
	local h = hit()
	h.type = kind or hit.wound
	h.power = power
	h.impulse = 0
	h.direction = vector():set(0, 0, 1)
	h.draftsman = db.actor
	db.actor:hit(h)
	god(true)
end

local function press_dik(dik, ms)
	level.press_action(dik)
	local t = time_global() + (ms or 100)
	while time_global() < t do
		level.hold_action(dik)
		coroutine.yield()
	end
	level.release_action(dik)
end

local function press(action, ms)
	press_dik(bind_to_dik(action), ms)
end

-- Which dialogs are up, from the callbacks the UI scripts send. (CUIActorMenu:IsShown() is false for the inventory even when it is
-- showing, so it is not used.) Escape with nothing open is the pause menu, which stops the level and this driver's tick: it is
-- only sent when a dialog is known to be open.
local shown = {}
local function gui_on_show(name) shown[name] = true end
local function gui_on_hide(name) shown[name] = nil end

local function ui_open()
	if next(shown) ~= nil then
		return true
	end
	return db.actor:is_talking()
end

local function close_ui(what)
	if not ui_open() then
		say("no dialog open to close (%s)", what)
		return
	end
	try("close " .. what, function() press_dik(DIK_keys.DIK_ESCAPE, 150) end)
	pause(1500)
	if ui_open() then
		-- the dialog did not take the key: the way a script closes the PDA and the actor menu
		try("hide " .. what, function()
			if ActorMenu.get_pda_menu():IsShown() then ActorMenu.get_pda_menu():HideDialog() end
			if ActorMenu.get_actor_menu():IsShown() then ActorMenu.get_actor_menu():HideDialog() end
		end)
		pause(1500)
	end
	say("%s closed: %s", what, tostring(not ui_open()))
end

local function face(obj)
	local d = vector():set(obj:position()):sub(db.actor:position())
	d.y = 0
	db.actor:set_actor_direction(d:getH())
end

local function level_is(name)
	return level.present() and db.actor ~= nil and level.name() == name
end

-- true once the actor stands in a running level (also the first frames of a fresh game)
local function actor_ready()
	return level.present() and db.actor ~= nil and db.actor:alive() and db.actor:level_vertex_id() ~= nil
end

-- a loaded save can come back with input and HUD still disabled by the script that saved it
local function enable_ui()
	pcall(function() level.enable_input() end)
	pcall(function() level.show_indicators() end)
end

-- after the actor died the game plays its game-over tutorial; its stop callback switches the main menu on (the player sees the
-- "Load last save" button then). A load during it would be followed by that callback.
local function finish_game_over()
	pause(5000)
	try("stop game-over tutorial", function() game.stop_tutorial() end)
	-- no pause here: with the menu on, the level (and this driver's tick) stands still; reload() is the "Load last save" button
end

local function reload(save)
	say("RELOAD %s", save)
	-- what the game-over screen's "Load" does (ui_main_menu LoadLastSave): the menu goes off, then the save loads
	get_console():execute("main_menu off")
	if save == "last" then
		get_console():execute("load_last_save")
	else
		get_console():execute("load " .. save)
	end
end

local function finish()
	say("DONE plan %s", plan_name)
	write_state(plan_name, 1)
	get_console():execute("quit")
end

-- scenario pieces -------------------------------------------------------------------------------------------------

local function gear_up()
	try("gear", function()
		give("wpn_pm", 1)
		give("ammo_9x18_fmj", 3, 30)
		give("wpn_ak74u", 1)
		give("ammo_5.45x39_fmj", 3, 30)
		give("medkit", 3)
		give("bandage", 3)
		give("bread", 2)
		give("vodka", 1)
		give("wpn_binoc", 1)
		give("detector_simple", 1)
		give("repair_kit_1", 1)
		give("guide_wpn_1", 1)
		give("stalker_outfit", 1)
	end)
	pause(1500)
end

local function arm()
	try("arm", function()
		local wpn = db.actor:object("wpn_ak74u") or db.actor:object("wpn_pm")
		if wpn then
			db.actor:make_item_active(wpn)
		end
	end)
	pause(2500)
end

local function fire_burst(target, ms)
	pcall(face, target)
	local dik = bind_to_dik(key_bindings.kWPN_FIRE)
	level.press_action(dik)
	local t = time_global() + ms
	while time_global() < t do
		pcall(face, target)
		level.hold_action(dik)
		coroutine.yield()
	end
	level.release_action(dik)
end

local function combat()
	say("-- combat")
	god(true) -- the enemies shoot for real, the actor does not die before the driver says so
	local enemies = {}
	for i, sec in ipairs({ "sim_default_bandit_0", "sim_default_bandit_1", "boar_normal", "dog_normal" }) do
		local ok, se = pcall(spawn_near, sec, 12 + i * 2, i * 1.3)
		if ok and se then
			enemies[#enemies + 1] = se.id
		end
	end
	pause(4000)
	try("hostile", function()
		for _, id in ipairs(enemies) do
			local o = level.object_by_id(id)
			if o and o:alive() and IsStalker(o) then
				o:set_relation(game_object.enemy, db.actor)
			end
		end
	end)
	for round = 1, 3 do
		for _, id in ipairs(enemies) do
			local o = level.object_by_id(id)
			if o and o:alive() then
				fire_burst(o, 1200)
				pcall(function() press(key_bindings.kWPN_RELOAD, 100) end)
				pause(800)
			end
		end
		try("hit", actor_hit, 0.08)
		pause(800)
	end
	try("bandage", function() db.actor:eat(db.actor:object("bandage")) end)
	pause(1200)
	try("medkit", function() db.actor:eat(db.actor:object("medkit")) end)
	pause(1200)
	try("kill_enemies", function()
		for _, id in ipairs(enemies) do
			local o = level.object_by_id(id)
			if o and o:alive() then
				o:kill(db.actor)
			end
		end
	end)
	pause(2500)
	say("health after combat %s", tostring(db.actor.health))
end

local function inventory()
	say("-- inventory")
	-- the key is dropped while the game is still settling after a load; ask again a few times
	for attempt = 1, 4 do
		try("open inventory", function() press(key_bindings.kINVENTORY, 150) end)
		if wait_for("the inventory", 6000, ui_open) then break end
	end
	say("inventory open: %s", tostring(ui_open()))
	pause(1500)
	try("slots", function()
		local wpn = db.actor:object("wpn_ak74u")
		if wpn then db.actor:move_to_slot(wpn, 2) end
		local pm = db.actor:object("wpn_pm")
		if pm then db.actor:move_to_slot(pm, 1) end
		local outfit = db.actor:object("stalker_outfit")
		if outfit then db.actor:move_to_slot(outfit, 7) end
		local det = db.actor:object("detector_simple")
		if det then db.actor:move_to_slot(det, 9) end
	end)
	pause(1500)
	try("belt/ruck", function()
		local m = db.actor:object("medkit")
		if m then
			db.actor:move_to_belt(m)
			db.actor:move_to_ruck(m)
		end
	end)
	try("condition", function()
		local w = db.actor:object("wpn_pm")
		if w then w:set_condition(0.4) end
	end)
	try("repair", function()
		local kit = db.actor:object("repair_kit_1")
		if kit then db.actor:eat(kit) end
	end)
	try("eat/use", function()
		db.actor:eat(db.actor:object("bread"))
		db.actor:eat(db.actor:object("vodka"))
	end)
	try("drop", function()
		local b = db.actor:object("bread")
		if b then db.actor:drop_item(b) end
		local c = db.actor:object("medkit")
		if c then db.actor:drop_item(c) end
	end)
	pause(1500)
	try("iterate", function()
		local n = 0
		db.actor:iterate_inventory(function() n = n + 1 end, db.actor)
		say("inventory items: %d", n)
	end)
	close_ui("inventory")
end

local function pda()
	say("-- pda")
	try("pda item", function() give("device_pda", 1) end)
	pause(1000)
	-- the PDA is opened like the engine does for its key; its tabs are switched through the PDA menu object
	try("open pda", function() ActorMenu.get_pda_menu():ShowDialog(true) end)
	pause(2500)
	say("pda open: %s", tostring(ui_open()))
	for _, tab in ipairs({ "eptTasks", "eptMap", "eptContacts", "eptLogs", "eptRanking", "eptRelations", "eptEncyclopedia", "eptRadio", "eptTasks" }) do
		try("pda tab " .. tab, function() ActorMenu.get_pda_menu():SetActiveSubdialog(tab) end)
		pause(1800)
	end
	pause(1500)
	close_ui("pda")
end

-- Anomaly's trade, loot and repair/upgrade windows are not the engine's CUIActorMenu: actor_menu_inventory's hooks
-- (CUIActorMenu_OnMode_Trade, _DeadBodySearch, _Upgrade) hand the mode to ui_inventory (a CUIScriptWnd, ui_inventory.GUI)
-- and return true, so the engine opens nothing. The driver looks at that window and uses its own handlers for the clicks.
local function inv_gui()
	return ui_inventory and ui_inventory.GUI
end

-- "inventory" / "loot" / "trade" / "repair" while the scripted window is up, else nil
local function gui_mode()
	local g = inv_gui()
	if g and g:IsShown() then
		return g.mode
	end
	return nil
end

local function count_of(owner, section)
	local n = 0
	owner:iterate_inventory(function(_, item)
		if item:section() == section then n = n + 1 end
	end, owner)
	return n
end

-- items of `owner` with this section, as game objects
local function items_of(owner, section)
	local list = {}
	owner:iterate_inventory(function(_, item)
		if item:section() == section then list[#list + 1] = item end
	end, owner)
	return list
end

-- sections of `owner`'s inventory, the cheapest first
local function sections_of(owner)
	local list, seen = {}, {}
	owner:iterate_inventory(function(_, item)
		local sec = item:section()
		if not seen[sec] and item:cost() > 0 then
			seen[sec] = true
			list[#list + 1] = { sec = sec, cost = item:cost() }
		end
	end, owner)
	table.sort(list, function(a, b) return a.cost < b.cost end)
	local out = {}
	for _, c in ipairs(list) do out[#out + 1] = c.sec end
	return out
end

-- the talk dialog's trade/upgrade key (kSPRINT_TOGGLE): pressed until the scripted window it leads to is up, at most 3 times
-- (the first press can land before the dialog has the focus); returns the number of presses it took, or 0
local function press_until(label, want)
	for attempt = 1, 3 do
		try(label .. " key " .. attempt, function() press(key_bindings.kSPRINT_TOGGLE, 150) end)
		if wait_for(label .. " window " .. want, 15000, function() return gui_mode() == want end) then
			return attempt
		end
		say("%s: no %s window after press %d (talking %s, window %s)", label, want, attempt, tostring(db.actor:is_talking()), tostring(gui_mode()))
	end
	return 0
end

-- One deal in the open trade window: an item goes to the buy (sell) list the way a double click moves it, then the Buy (Sell)
-- button's handler runs. Items and money have to move the right way: what the actor gains the partner loses and back.
local function trade_deal(trader, buying, sections, label)
	local gui = inv_gui()
	local what = label .. (buying and " buy " or " sell ")
	local bag, list = "actor_trade_bag", "actor_trade"
	local giver, taker = db.actor, trader
	if buying then
		bag, list = "npc_trade_bag", "npc_trade"
		giver, taker = trader, db.actor
	end
	for _, sec in ipairs(sections) do
		for _, item in ipairs(items_of(giver, sec)) do
			if gui.CC[bag]:GetCell_ID(item:id()) and gui.CC[bag]:IsTradable(item) then
				gui:Action_Move(item, bag)
				if gui.CC[list]:GetCell_ID(item:id()) then
					local before = { taker = count_of(taker, sec), giver = count_of(giver, sec), actor = db.actor:money(), trader = trader:money() }
					if buying then gui:TMode_Buy() else gui:TMode_Sell() end
					pause(2500) -- the item events go through the server
					local after = { taker = count_of(taker, sec), giver = count_of(giver, sec), actor = db.actor:money(), trader = trader:money() }
					say("%s%s: items %d -> %d (partner %d -> %d), money actor %d -> %d, trader %d -> %d", what, sec,
						before.taker, after.taker, before.giver, after.giver, before.actor, after.actor, before.trader, after.trader)
					check(what .. sec .. ": the item moved", after.taker == before.taker + 1 and after.giver == before.giver - 1,
						string.format("taker %d -> %d, giver %d -> %d", before.taker, after.taker, before.giver, after.giver))
					-- A character with infinite money (inf_money in its profile, Sidorovich among them) never loses any: set_money keeps the
					-- larger value. So a sale pays out of nothing there, and the check is that his purse did not shrink by a different amount.
					local paid = buying and (before.actor - after.actor) or (after.actor - before.actor)
					local got = buying and (after.trader - before.trader) or (before.trader - after.trader)
					local ok = paid > 0 and (got == paid or (not buying and after.trader == before.trader))
					check(what .. sec .. ": the money moved the right way", ok,
						string.format("actor %d -> %d, trader %d -> %d", before.actor, after.actor, before.trader, after.trader))
					return true
				end
			end
		end
	end
	check(what .. "something to move", false, "none of " .. #sections .. " sections could be put on the list")
	return false
end

-- a trade window opened by `how` with `trader`; `deals`: make a buy and a sell in it
local function trade_with(trader, label, how, deals)
	try(label .. " open", how)
	if gui_mode() ~= "trade" then wait_for(label .. " trade window", 20000, function() return gui_mode() == "trade" end) end
	pause(1500)
	local mode = gui_mode()
	check(label .. ": trade window opens", mode == "trade", "window mode " .. tostring(mode))
	if mode == "trade" and deals then
		try(label .. " deals", function()
			db.actor:give_money(20000)
			trader:give_money(20000)
			trade_deal(trader, true, sections_of(trader), label)
			trade_deal(trader, false, { "bread", "kolbasa", "conserva", "vodka", "medkit", "bandage", "ammo_9x18_fmj", "wpn_pm" }, label)
		end)
		pause(1500)
	end
	close_ui(label)
	check(label .. ": closes", gui_mode() == nil, "window mode " .. tostring(gui_mode()))
end

local function trade()
	say("-- trade/dialog")
	local trader = nil
	try("find trader", function()
		trader = get_story_object("esc_m_trader")
		say("trader %s", trader and trader:name() or "nil")
	end)
	check("trader found", trader ~= nil)
	if not trader then return end
	try("goto trader", function()
		db.actor:set_actor_position(trader:position())
	end)
	pause(4000)
	try("trader state", function()
		trader = get_story_object("esc_m_trader")
		check("the actor is alive", db.actor:alive(), "health " .. tostring(db.actor.health))
		say("trader alive %s, %s m away, is_trade_enabled %s", tostring(trader:alive()), tostring(math.floor(db.actor:position():distance_to(trader:position()))), tostring(trader:is_trade_enabled()))
	end)
	try("gear", function()
		give("bread", 3)
		give("medkit", 2)
		give("bandage", 2)
		give("wpn_pm", 1)
	end)

	-- the player's way: talk to the trader, press the dialog's trade key
	try("talk", function()
		trader = get_story_object("esc_m_trader")
		db.actor:run_talk_dialog(trader, false)
	end)
	wait_for("talk window", 30000, function() return db.actor:is_talking() end)
	pause(1500)
	check("talk window opens", db.actor:is_talking())
	trade_with(trader, "talk", function() press_until("talk", "trade") end, true)
	close_ui("talk") -- the talk window is still up behind the trade window
	check("talk window closes", not db.actor:is_talking())

	-- the script's way: trader:start_trade(actor); the actor is the argument
	try("refresh trader", function() trader = get_story_object("esc_m_trader") end)
	trade_with(trader, "script", function() trader:start_trade(db.actor) end, true)

	-- the reversed call is not a trade
	try("reversed start_trade", function() db.actor:start_trade(trader) end)
	pause(1500)
	check("reversed start_trade opens nothing", gui_mode() == nil, "window mode " .. tostring(gui_mode()))
end

-- alife():register(se_obj) writes the server object out, destroys it and returns the one made from the packet; scripts (death_manager,
-- item_parts) go on reading the object they passed: it has to stay valid. ASan reports a use after free if it does not.
-- level.add_call(condition, action) puts a call into the physics commander (CLevel::OnFrame -> CPHCommander::update runs them). The actions run
-- scripts, and a script may remove calls: its own (CPHScriptAction::run() then wrote b_obsolete into the freed action), the next one, one it
-- has already run. update() indexed m_calls after the action had erased from it. Every action here removes some of the others; each must
-- run exactly once and nothing may crash (ASan: heap-use-after-free; MallocScribble: a wild pointer).
local function phcalls()
	say("-- ph commander: calls that remove calls")
	local N = 12
	local ran, conds, acts = {}, {}, {}
	for i = 1, N do
		ran[i] = 0
		conds[i] = function() return true end
		acts[i] = function()
			ran[i] = ran[i] + 1
			if i % 4 == 1 then level.remove_call(conds[i], acts[i]) end                        -- itself
			if i % 4 == 2 and i < N then level.remove_call(conds[i + 1], acts[i + 1]) end        -- the next one, not run yet
			if i % 4 == 3 then level.remove_call(conds[i - 1], acts[i - 1]) end                  -- the previous one, already run
			if i % 4 == 0 and i > 4 then level.remove_call(conds[i - 3], acts[i - 3]) end        -- one a few places back
		end
	end
	-- The calls are added from a callback, not from this coroutine: a luabind functor keeps the lua_State it was made on, and this
	-- coroutine is suspended (in pause()) while the commander runs them.
	local request = false
	local function on_update()
		if request then
			request = false
			for i = 1, N do level.add_call(conds[i], acts[i]) end
		end
	end
	RegisterScriptCallback("actor_on_update", on_update)
	for round = 1, 20 do
		for i = 1, N do ran[i] = 0 end
		request = true
		-- until every call that is not removed before it runs has run (a slow build, TSan, needs seconds), then a little longer for a second run
		wait_for("the ph calls to run", 20000, function()
			for i = 1, N do
				if i % 4 ~= 3 and ran[i] < 1 then return false end
			end
			return true
		end)
		pause(500)
		local bad = {}
		for i = 1, N do
			-- 2 is removed by 1? no: odd i % 4 == 1 removes itself, i % 4 == 2 removes i+1 (i+1 % 4 == 3) before it runs
			local expect_removed_before_run = (i % 4 == 3)
			if ran[i] > 1 or (not expect_removed_before_run and ran[i] ~= 1) then bad[#bad + 1] = i .. "=" .. ran[i] end
		end
		check("ph calls round " .. round .. ": each action ran once", #bad == 0, table.concat(bad, " "))
	end
	UnregisterScriptCallback("actor_on_update", on_update)
end

local function reprocess()
	say("-- register / reprocess_spawn")
	local olds = {}
	for i = 1, 6 do
		local se, id = nil, nil
		try("create unregistered " .. i, function()
			se = alife_create("bread", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id(), false)
			id = se.id
		end)
		if se then
			try("register " .. i, function() alife():register(se) end)
			check("register " .. i .. ": the old object reads the same id", se.id == id, tostring(se.id) .. " vs " .. tostring(id))
			check("register " .. i .. ": its section", se:section_name() == "bread")
			pause(1500) -- a few frames on: still readable
			check("register " .. i .. ": still readable later", se.id == id)
			check("register " .. i .. ": the registered object exists", alife():object(id) ~= nil)
			olds[#olds + 1] = { se = se, id = id }
		end
	end
	pause(15000) -- the old objects stay valid for as long as the simulator lives, not for a few seconds
	for i, o in ipairs(olds) do
		check("register " .. i .. ": the old object still reads its id 15 s later", o.se.id == o.id)
	end
	check("registered items arrived", count_of(db.actor, "bread") >= 6, tostring(count_of(db.actor, "bread")))

	-- alife():release: the entity is freed by the simulator, a script that kept it (axr_companions keeps squads in a table and reads
	-- them later) still reads it
	local released = {}
	for i = 1, 6 do
		local se, id = nil, nil
		try("create for release " .. i, function()
			se = alife_create("bread", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id())
			id = se.id
		end)
		if se then
			pause(500)
			try("release " .. i, function() alife():release(se, true) end)
			check("release " .. i .. ": the released object reads its id", se.id == id and se:section_name() == "bread")
			released[#released + 1] = { se = se, id = id }
			pause(300)
		end
	end
	pause(15000)
	for i, o in ipairs(released) do
		check("release " .. i .. ": the released object still reads 15 s later", o.se.id == o.id and o.se:section_name() == "bread")
	end
end

-- the loot window of a body or a stash: opened the way the engine's use does, everything taken with the window's own keys
-- (Shift+T), and the items arrive
local function loot_check(owner, label, sections)
	local before = {}
	for _, sec in ipairs(sections) do before[sec] = count_of(db.actor, sec) end
	try(label .. " use", function() owner:use(db.actor) end)
	wait_for(label .. " loot window", 8000, function() return gui_mode() == "loot" end)
	pause(1500)
	local mode = gui_mode()
	check(label .. ": loot window opens", mode == "loot", "window mode " .. tostring(mode))
	if mode == "loot" then
		try(label .. " take all", function()
			level.press_action(DIK_keys.DIK_LSHIFT)
			pause(300)
			press_dik(DIK_keys.DIK_T, 150)
			level.release_action(DIK_keys.DIK_LSHIFT)
		end)
		pause(3000)
		for _, sec in ipairs(sections) do
			local now = count_of(db.actor, sec)
			check(label .. ": " .. sec .. " taken", now > before[sec], tostring(before[sec]) .. " -> " .. tostring(now))
		end
	end
	close_ui(label)
	check(label .. ": closes", gui_mode() == nil, "window mode " .. tostring(gui_mode()))
end

local function loot()
	say("-- loot")
	-- a body: a bandit, killed, with a few things in his pockets
	local body = nil
	try("spawn bandit", function()
		local se = spawn_near("sim_default_bandit_0", 6, 0.5)
		wait_for("bandit online", 20000, function() return se and level.object_by_id(se.id) ~= nil end)
		pause(1500)
		body = se and level.object_by_id(se.id)
	end)
	check("bandit online", body ~= nil)
	if body then
		try("kill bandit", function() body:kill(db.actor) end)
		pause(3000)
		try("fill body", function()
			alife_create_item("conserva", body)
			alife_create_item("conserva", body)
			alife_create_item("bandage", body)
		end)
		pause(2500)
		loot_check(body, "body", { "conserva", "bandage" })
	end

	-- a stash
	local box = nil
	try("spawn stash", function()
		local pos, lvid = spot(4, 1.0)
		local se = alife_create("inventory_box", pos, lvid, db.actor:game_vertex_id())
		wait_for("stash online", 20000, function() return se and level.object_by_id(se.id) ~= nil end)
		pause(1500)
		box = se and level.object_by_id(se.id)
	end)
	check("stash online", box ~= nil)
	if box then
		try("fill stash", function()
			alife_create_item("kolbasa", box)
			alife_create_item("kolbasa", box)
			alife_create_item("medkit", box)
		end)
		pause(2500)
		loot_check(box, "stash", { "kolbasa", "medkit" })
	end
end

-- Every stalker of the whole game whose name looks like a vendor; the A-Life object is the same one on or off line.
local function find_vendors(patterns)
	local out = {}
	local sim = alife()
	for id = 1, 65534 do
		local se = sim:object(id)
		if se then
			local name = se:name()
			for _, pat in ipairs(patterns) do
				if name:find(pat) and not name:find("awr_lamp") and (se:clsid() == clsid.script_stalker or se:clsid() == clsid.stalker) then
					out[#out + 1] = { id = id, name = name, pos = se.position }
					break
				end
			end
		end
	end
	return out
end

-- go to a vendor (an A-Life object) and wait until it is online next to the actor
local function go_to_vendor(v)
	db.actor:set_actor_position(v.pos)
	wait_for("vendor " .. v.name .. " online", 20000, function() return level.object_by_id(v.id) ~= nil end)
	pause(3000)
	return level.object_by_id(v.id)
end

-- The mechanic's repair window: opened by the script (start_upgrade), a damaged gun selected the way a click on it does, and the
-- window's "yes" to the repair question; the gun has to be whole afterwards, for money. (The talk dialog's trade key opens the window
-- of a character with trade enabled only; a mechanic's window comes from his dialog lines.)
local function mechanic_check(m, label)
	try(label .. " gear", function()
		give("wpn_pm", 1)
		db.actor:give_money(20000)
		local w = db.actor:object("wpn_pm")
		w:set_condition(0.4)
	end)
	pause(1500)
	try(label .. " start_upgrade", function() m:start_upgrade(db.actor) end)
	wait_for(label .. " repair window", 10000, function() return gui_mode() == "repair" end)
	pause(1500)
	local open = gui_mode() == "repair"
	check(label .. ": repair window opens", open, "window mode " .. tostring(gui_mode()))
	if open then
		try(label .. " repair", function()
			local gui = inv_gui()
			local w = db.actor:object("wpn_pm")
			local before = { cond = w:condition(), money = db.actor:money() }
			local idx = gui.CC["actor_bag"]:GetCell_ID(w:id(), true)
			gui:RMode_InitItem(w, "actor_bag", idx)
			check(label .. ": the gun is selected", gui.upgr and gui.upgr.id == w:id())
			gui:RMode_RepairYes()
			pause(2500)
			local after = { cond = db.actor:object("wpn_pm"):condition(), money = db.actor:money() }
			say("%s repair: condition %s -> %s, money %d -> %d", label, tostring(before.cond), tostring(after.cond), before.money, after.money)
			check(label .. ": repaired", after.cond > 0.95 and before.cond < 0.5, tostring(before.cond) .. " -> " .. tostring(after.cond))
		end)
	end
	close_ui(label .. " repair")
	check(label .. ": closes", gui_mode() == nil, "window mode " .. tostring(gui_mode()))
end

-- the Bar: the Barkeep (a trader) and the mechanic
local function other_vendors()
	say("-- other vendors")
	local found = {}
	try("find vendors", function()
		found = find_vendors({ "barman", "trader", "mechanic", "_tech", "cardan" })
	end)
	-- the vendors of this level: their names start with the level's short name ("bar_" in l05_bar)
	local short = level.name():match("^l%d+u?_(.+)$") or level.name()
	local barkeep, mechanic = nil, nil
	for _, v in ipairs(found) do
		if v.name:find("^" .. short .. "_") then
			say("vendor %s id %s", v.name, tostring(v.id))
			if not barkeep and v.name:find("barman") then barkeep = v end
			if not mechanic and (v.name:find("mechanic") or v.name:find("_tech") or v.name:find("cardan")) then mechanic = v end
		end
	end
	check("a barkeep was found", barkeep ~= nil)
	check("a mechanic was found", mechanic ~= nil)
	if barkeep then
		local o = nil
		try("go to " .. barkeep.name, function() o = go_to_vendor(barkeep) end)
		check("barkeep online", o ~= nil)
		if o then
			-- the dialog's trade key works for a character with trade enabled; the Barkeep's trade switches on with the game's story
			local enabled = o:is_trade_enabled()
			say("barkeep trade enabled: %s", tostring(enabled))
			if enabled then
				try("barkeep talk", function() db.actor:run_talk_dialog(o, false) end)
				pause(3500)
				check("barkeep: talk window opens", db.actor:is_talking())
				trade_with(o, "barkeep talk", function() press_until("barkeep talk", "trade") end, true)
				close_ui("barkeep talk")
			end
			trade_with(o, "barkeep script", function() o:start_trade(db.actor) end, true)
		end
	end
	if mechanic then
		local o = nil
		try("go to " .. mechanic.name, function() o = go_to_vendor(mechanic) end)
		check("mechanic online", o ~= nil)
		if o then mechanic_check(o, "mechanic") end
	end
end

local function surge()
	say("-- emission")
	try("start surge", function()
		local sm = surge_manager.get_surge_manager()
		sm.started = false
		sm:start(true)
		say("surge started=%s", tostring(sm.started))
	end)
	try("time factor", function() level.set_time_factor(20) end)
	pause(15000)
	try("psi storm", function()
		local pm = psi_storm_manager.get_psi_storm_manager()
		pm:start(true)
	end)
	pause(8000)
	try("end surge", function()
		local sm = surge_manager.get_surge_manager()
		if sm.started then sm:end_surge(true) end
		level.set_time_factor(1)
	end)
	pause(3000)
end

local function surge_start_only()
	try("start surge", function()
		local sm = surge_manager.get_surge_manager()
		sm.started = false
		sm:start(true)
	end)
	try("time factor", function() level.set_time_factor(20) end)
end

local function anomalies()
	say("-- anomalies / artefacts")
	god(true)
	try("artefact", function()
		give("af_medusa", 1)
		give("af_blood", 1)
		give("af_vyvert", 1)
	end)
	-- the anomaly zones of the level (a zone made by alife():create has no shape, and CCustomZone asserts on that)
	local n = 0
	for name, binder in pairs(db.anomaly_by_name or {}) do
		n = n + 1
		if n <= 3 then
			try("respawn artefacts in " .. tostring(name), function() binder:respawn_artefacts_and_replace_anomaly_zone() end)
			try("walk into " .. tostring(name), function() db.actor:set_actor_position(binder.object:position()) end)
			pause(6000)
		end
	end
	say("anomaly zones on the level: %d", n)
	try("belt artefact", function()
		local af = db.actor:object("af_medusa")
		if af then db.actor:move_to_belt(af) end
	end)
	pause(3000)
end

local function sleeping()
	say("-- sleep / wait")
	try("sleep", function()
		level.set_time_factor(60)
		actor_status_sleep.force_sleep()
	end)
	pause(10000)
	try("restore time", function() level.set_time_factor(1) end)
	pause(1500)
end

local function save_here(name)
	try("save " .. name, function()
		get_console():execute("save " .. name)
	end)
	pause(4000)
end

-- phases ----------------------------------------------------------------------------------------------------------
-- A phase gets called inside the coroutine and returns what to do next: nothing (go on with the next phase in this
-- session), {reload = "<save>"} or {quit = true}.
local phases = {
	smoke = {
		function() -- fresh Cordon: gear, combat, inventory, a mid-combat save, then death and reload
			if not wait_for("the Cordon", 240000, function() return level_is("l01_escape") end) then return { quit = true } end
			pause(8000)
			gear_up()
			arm()
			combat()
			inventory()
			try("spawn for save", function()
				spawn_near("sim_default_bandit_2", 14, 0.5)
				spawn_near("boar_normal", 16, 2.0)
			end)
			pause(3000)
			save_here("sweep_smoke")
			try("die", function() god(false); db.actor:kill(db.actor) end)
			finish_game_over()
			return { reload = "last" }
		end,
		function() -- after the reload: PDA, trade, a level change, one more save, then reload that one too
			if not wait_for("the reload", 240000, function() return actor_ready() and level_is("l01_escape") end) then return { quit = true } end
			enable_ui()
			-- the save was made with enemies around and god mode is not part of a save: without it they kill the actor while the PDA
			-- and the trade steps run (a dead actor cannot be teleported or talk, and a level change then never gets its first update)
			god(true)
			pause(6000)
			say("reloaded, health %s, alive %s", tostring(db.actor.health), tostring(db.actor:alive()))
			pda()
			reprocess()
			trade()
			try("to garbage", function()
				get_console():execute("jump_to_level l02_garbage")
			end)
			return { next = true } -- the level change rebuilds the Lua state; phase 3 starts at the first update there
		end,
		function() -- in the Garbage
			if not wait_for("the Garbage", 240000, function() return level_is("l02_garbage") end) then return { quit = true } end
			enable_ui()
			pause(8000)
			say("in garbage")
			try("inland", function() move_inland(120) end)
			pause(4000)
			gear_up()
			arm()
			combat()
			save_here("sweep_smoke2")
			return { quit = true }
		end,
	},
	-- a fresh game: wait for the Cordon, take the base save every other plan starts from
	newgame = {
		function()
			if not wait_for("the Cordon", 300000, function() return level_is("l01_escape") end) then return { quit = true } end
			pause(10000)
			save_here("sweep_base")
			return { quit = true }
		end,
	},
	-- one scenario each (run on a loaded save or a fresh game)
	combat = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); gear_up(); arm(); combat(); return { quit = true } end },
	inventory = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(12000); gear_up(); inventory(); return { quit = true } end },
	pda = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); pda(); return { quit = true } end },
	reprocess = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); reprocess(); return { quit = true } end },
	-- the Bar's vendors alone (the second phase of trade)
	vendors = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000)
			get_console():execute("jump_to_level l05_bar")
			return { next = true }
		end,
		function()
			if not wait_for("the Bar", 240000, function() return level_is("l05_bar") end) then return { quit = true } end
			enable_ui()
			pause(10000)
			god(true)
			other_vendors()
			return { quit = true }
		end,
	},
	-- the actor menu's modes: Sidorovich (talk and script), a body and a stash; then the Bar for its Barkeep and the mechanic
	trade = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000)
			god(true)
			trade()
			loot()
			get_console():execute("jump_to_level l05_bar")
			return { next = true }
		end,
		function()
			if not wait_for("the Bar", 240000, function() return level_is("l05_bar") end) then return { quit = true } end
			enable_ui()
			pause(10000)
			god(true)
			other_vendors()
			return { quit = true }
		end,
	},
	surge = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); surge(); return { quit = true } end },
	anomalies = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); gear_up(); anomalies(); return { quit = true } end },
	sleep = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); sleeping(); return { quit = true } end },
	-- Cordon -> Garbage -> Cordon; every level change rebuilds the Lua state, so each hop is a phase
	transition = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(6000)
			get_console():execute("jump_to_level l02_garbage")
			return { next = true }
		end,
		function()
			if not wait_for("the Garbage", 240000, function() return level_is("l02_garbage") end) then return { quit = true } end
			enable_ui()
			pause(10000)
			say("in garbage")
			get_console():execute("jump_to_level l01_escape")
			return { next = true }
		end,
		function()
			if not wait_for("the Cordon", 240000, function() return level_is("l01_escape") end) then return { quit = true } end
			enable_ui()
			pause(10000)
			say("back in the Cordon")
			return { quit = true }
		end,
	},
	-- die, then load the last save the way the game-over screen's "Load last save" does
	die_reload = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(8000)
			save_here("sweep_die")
			try("die", function() god(false); db.actor:kill(db.actor) end)
			finish_game_over()
			return { reload = "last" }
		end,
		function()
			wait_for("the reload", 240000, actor_ready); enable_ui()
			pause(8000)
			say("alive again: %s", tostring(db.actor:alive()))
			return { quit = true }
		end,
	},
	-- quit from a state: reach it on sweep_base, then ask the engine to quit with the state still up
	quit_level = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(3000); return { quit = true } end },
	-- stands in the level until the --script ends the run (quit_background_level: lifecycle background, then quit)
	phcalls = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(3000); phcalls(); return { quit = true } end },
	hold = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(900000); return { quit = true } end },
	quit_inventory = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(12000)
			for attempt = 1, 4 do
				try("open inventory", function() press(key_bindings.kINVENTORY, 150) end)
				if wait_for("the inventory", 6000, ui_open) then break end
			end
			pause(2000)
			say("inventory open: %s", tostring(ui_open()))
			return { quit = true }
		end,
	},
	quit_pda = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(5000)
			try("give pda", function() give("device_pda", 1) end)
			try("open pda", function() ActorMenu.get_pda_menu():ShowDialog(true) end)
			pause(3000)
			say("pda open: %s", tostring(ui_open()))
			return { quit = true }
		end,
	},
	quit_dialog = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(5000)
			local trader = get_story_object("esc_m_trader")
			db.actor:set_actor_position(trader:position())
			pause(4000)
			trader = get_story_object("esc_m_trader")
			try("talk", function() db.actor:run_talk_dialog(trader, false) end)
			pause(4000)
			say("talk open: %s", tostring(ui_open()))
			return { quit = true }
		end,
	},
	quit_combat = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(5000)
			god(true)
			gear_up()
			arm()
			for i, sec in ipairs({ "sim_default_bandit_0", "sim_default_bandit_1", "boar_normal" }) do
				pcall(spawn_near, sec, 10 + i * 2, i * 1.3)
			end
			pause(6000)
			return { quit = true }
		end,
	},
	quit_dead = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); try("die", function() god(false); db.actor:kill(db.actor) end); pause(6000); return { quit = true } end },
	quit_surge = { function() wait_for("actor", 240000, actor_ready); enable_ui(); pause(5000); surge_start_only(); pause(8000); return { quit = true } end },
	saveload = {
		function()
			wait_for("actor", 240000, actor_ready); enable_ui()
			pause(5000)
			gear_up()
			arm()
			try("spawn", function()
				spawn_near("sim_default_bandit_0", 12, 0.5)
				spawn_near("boar_normal", 14, 2.0)
			end)
			pause(3000)
			save_here("sweep_mid_combat")
			return { reload = "sweep_mid_combat" }
		end,
		function()
			wait_for("the reload", 240000, actor_ready); enable_ui()
			pause(8000)
			combat()
			return { quit = true }
		end,
	},
}

-- the driver ------------------------------------------------------------------------------------------------------
local function start_phase()
	local list = phases[plan_name]
	if not list or not list[phase_index] then
		say("no phase %s/%d, quitting", tostring(plan_name), phase_index)
		finish()
		return
	end
	say("PHASE %s #%d", plan_name, phase_index)
	co = coroutine.create(list[phase_index])
	started_at = time_global()
end

local ticks = 0
local tick_frame = -1
local function on_update()
	-- one step per frame, whichever tick source calls (a reload can leave an older registration alive)
	local frame = device().frame
	if frame == tick_frame then
		return
	end
	tick_frame = frame
	ticks = ticks + 1
	if ticks % 600 == 1 then
		say("tick %d (co %s)", ticks, co and coroutine.status(co) or "none")
	end
	if not co then
		return
	end
	local ok, res = coroutine.resume(co)
	if not ok then
		say("FAIL phase %s #%d: %s", plan_name, phase_index, tostring(res))
		co = nil
		finish()
		return
	end
	if coroutine.status(co) == "dead" then
		co = nil
		if type(res) == "table" and res.reload then
			write_state(plan_name, phase_index + 1)
			reload(res.reload)
		elseif type(res) == "table" and res.next then
			write_state(plan_name, phase_index + 1) -- carried on by the next first update (a level change)
		elseif type(res) == "table" and res.quit then
			finish()
		else
			phase_index = phase_index + 1
			start_phase()
		end
	end
end

-- level.add_call runs every frame of the level, also while the actor is dead (actor_on_update does not)
local function register_tick()
	level.add_call(function() on_update() return false end, function() end)
end

local function on_first_update()
	-- the first game starts at fake_start (the faction dialog) and changes level; a load comes here too
	if co then
		return
	end
	local saved_plan, saved_index = read_state()
	if saved_plan == plan_name then
		phase_index = saved_index
	else
		phase_index = 1
	end
	say("plan %s, phase %d", plan_name, phase_index)
	register_tick()
	start_phase()
end

function on_game_start()
	plan_name = os.getenv("ANOMALY_SWEEP")
	if not plan_name or plan_name == "" then
		return
	end
	say("driver armed: plan %s", plan_name)
	RegisterScriptCallback("actor_on_first_update", on_first_update)
	RegisterScriptCallback("GUI_on_show", gui_on_show)
	RegisterScriptCallback("GUI_on_hide", gui_on_hide)
	if plan_name == "keytest" then
		RegisterScriptCallback("on_before_key_press", function(dik, bind, dis, flags)
			if dik == 23 or dik == 25 then say("on_before_key_press dik=%s bind=%s dis=%s ret=%s", dik, bind, tostring(dis), tostring(flags.ret_value)) end
		end)
		RegisterScriptCallback("ActorMenu_on_before_init_mode", function(mode, flags, obj)
			say("ActorMenu_on_before_init_mode %s ret=%s", tostring(mode), tostring(flags.ret))
		end)
	end
end
