--[[
	Systems check, part 2: the world. A-Life, combat AI, anomalies and artefacts, emissions, weather, sleeping, stashes,
	companions, travel. See sweep_check.script.
--]]

local C, H

local function give(...) return H.give(...) end

local function start_quiet()
	H.wait_for("actor", 240000, H.actor_ready)
	H.enable_ui()
	H.pause(6000)
	H.god(false)
end

-- the game clock at `factor` times the normal rate for `ms` real milliseconds (surge_manager puts it back every second)
local function fast_forward(factor, ms)
	local t0 = game.get_game_time()
	local normal = level.get_time_factor()
	local t_end = time_global() + ms
	while time_global() < t_end do
		level.set_time_factor(factor)
		coroutine.yield()
	end
	level.set_time_factor(normal)
	return game.get_game_time():diffSec(t0)
end

local function dist3(a, b)
	return a:distance_to(b)
end

-- A-Life -------------------------------------------------------------------------------------------------------------------------
-- SIMBOARD.squads maps a squad id to true; the squad is the server object
local function each_squad()
	local list = {}
	for id in pairs(SIMBOARD.squads) do
		local sq = alife():object(id)
		if sq then list[#list + 1] = sq end
	end
	return list
end

local function squad_snapshot()
	local t = {}
	for _, squad in ipairs(each_squad()) do
		local id = squad.id
		t[id] = { smart = squad.smart_id, assigned = squad.assigned_target_id, current = squad.current_target_id, pos = vector():set(squad.position), gvid = squad.m_game_vertex_id, online = squad.online }
	end
	return t
end

local function alife_plan()
	start_quiet()
	local n_squads, n_online, n_members, n_smarts = 0, 0, 0, 0
	for _, squad in ipairs(each_squad()) do
		n_squads = n_squads + 1
		if squad.online then n_online = n_online + 1 end
		for _ in squad:squad_members() do n_members = n_members + 1 end
	end
	for _ in pairs(SIMBOARD.smarts) do n_smarts = n_smarts + 1 end
	C.check("a-life", "population", n_squads > 20 and n_smarts > 20 and n_members > 30, string.format("%d squads (%d online) with %d members, %d smart terrains", n_squads, n_online, n_members, n_smarts))

	-- squads move between smart terrains as the clock runs
	local s0 = squad_snapshot()
	local secs = fast_forward(300, 45000)
	local s1 = squad_snapshot()
	local retargeted, moved_gv, lost = 0, 0, 0
	for id, a in pairs(s0) do
		local b = s1[id]
		if not b then
			lost = lost + 1
		else
			if a.assigned ~= b.assigned or a.smart ~= b.smart or a.current ~= b.current then retargeted = retargeted + 1 end
			if a.gvid ~= b.gvid then moved_gv = moved_gv + 1 end
		end
	end
	C.check("a-life", "clock", secs > 10000, string.format("%.0f game seconds simulated", secs))
	C.check("a-life", "squads-retarget", retargeted >= 3, string.format("%d of %d squads picked a new smart terrain, %d moved on the game graph, %d gone", retargeted, n_squads, moved_gv, lost))
	C.check("a-life", "squads-move", moved_gv >= 3, string.format("%d squads changed game vertex", moved_gv))

	-- offline / online: the actor goes to the far side of the level; the squads there come online and the ones it left go offline
	local function online_set()
		local t = {}
		for _, sq in ipairs(each_squad()) do
			if sq.online then t[sq.id] = sq:name() end
		end
		return t
	end
	local function count(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end
	local ap = vector():set(db.actor:position())
	local my_level = game_graph():vertex(db.actor:game_vertex_id()):level_id()
	local farthest, far_d = nil, 0
	for _, squad in ipairs(each_squad()) do
		for m in squad:squad_members() do
			local se = alife_object(m.id)
			if se and se.m_game_vertex_id and game_graph():vertex(se.m_game_vertex_id):level_id() == my_level then
				local d = se.position:distance_to(ap)
				if d > far_d then farthest, far_d = se, d end
			end
		end
	end
	if not farthest then
		C.check("a-life", "online-switch", false, "no squad member on this level")
		return C.done("chk_alife")
	end
	H.say("switch distance %s, farthest squad member %s at %s m", tostring(alife():switch_distance()), farthest:name(), tostring(math.floor(far_d)))
	local before = online_set()
	H.god(true)
	db.actor:set_actor_position(farthest.position)
	H.pause(25000)
	local after = online_set()
	local came, went = {}, {}
	for id, n in pairs(after) do if not before[id] then came[id] = n end end
	for id, n in pairs(before) do if not after[id] then went[id] = n end end
	C.check("a-life", "goes-online", count(came) > 0, string.format("%d squads online before, %d after the actor moved %.0f m; %d came online", count(before), count(after), far_d, count(came)))
	C.check("a-life", "goes-offline", count(went) > 0, string.format("%d squads left online range", count(went)))
	local made = 0
	for id in pairs(came) do
		local sq = alife():object(id)
		if sq then
			for m in sq:squad_members() do
				if level.object_by_id(m.id) then made = made + 1 end
			end
		end
	end
	C.check("a-life", "game-objects", made > 0, string.format("%d members of the squads that came online exist as game objects", made))
	H.god(false)
	return C.done("chk_alife")
end

-- combat AI ----------------------------------------------------------------------------------------------------------------------
-- a walkable spot about `dist` metres from the actor (a game-graph vertex of the level; the actor's own level vertex search stops at walls)
local function here(dist, ang)
	local pos, lvid, gvid, d = C.point_at(dist)
	return pos, lvid, d, gvid
end

local function spawn_at(sec, dist, ang)
	local pos, lvid, d, gvid = here(dist, ang)
	local se = alife_create(sec, pos, lvid, gvid or db.actor:game_vertex_id())
	if se then se.__spawn_dist = d end
	return se
end

local function hits_counter()
	local n = { hits = 0 }
	RegisterScriptCallback("actor_on_hit_callback", function(obj, amount, local_direction, who, bone_index)
		n.hits = n.hits + 1
		n.last_who = who and who:section() or "?"
	end)
	return n
end

local function mutants_plan()
	start_quiet()
	H.gear_up()
	H.arm()
	local counter = hits_counter()
	-- one species after another: it comes at the actor, bites, and a rifle kills it
	local species = { "dog_normal", "boar_normal", "flesh_normal", "snork_normal", "bloodsucker_normal", "pseudodog_normal", "cat_normal" }
	for _, sec in ipairs(species) do
		C.run("mutants", sec, function()
			if not ini_sys:section_exist(sec) then return true, "no such section on this build, skipped" end
			H.god(false)
			db.actor.health = 1
			local se = spawn_at(sec, 22, 1.0)
			if not se then return false, "alife_create returned nil" end
			H.pause(3000)
			local m = level.object_by_id(se.id)
			if not m then return false, "the mutant did not come online" end
			local d0 = dist3(m:position(), db.actor:position())
			local hits0 = counter.hits
			local closest = d0
			local attacked = false
			for i = 1, 25 do
				H.pause(1000)
				if not m:alive() then break end
				local d = dist3(m:position(), db.actor:position())
				if d < closest then closest = d end
				if counter.hits > hits0 or db.actor.health < 0.995 then attacked = true end
				if attacked then break end
			end
			local hp = db.actor.health
			if m:alive() then m:kill(db.actor) end
			H.pause(800)
			db.actor.health = 1
			return attacked, string.format("%s: closest %.1f m (started %.1f), actor health %.2f after it attacked", sec, closest, d0, hp)
		end)
	end
	-- ranged mutants and a few that need a target of their own
	return C.done("chk_mutants")
end

local function stalkers_plan()
	start_quiet()
	H.gear_up()
	H.arm()
	local counter = hits_counter()
	-- hostile stalkers shoot at the actor and move to cover
	C.run("stalkers", "hostile-fire", function()
		H.god(true) -- they shoot for real; the actor does not die before the check has looked
		local a = spawn_at("sim_default_bandit_0", 18, 0.8)
		local b = spawn_at("sim_default_bandit_1", 20, 1.4)
		H.pause(3500)
		local ids = {}
		for _, se in ipairs({ a, b }) do
			local o = se and level.object_by_id(se.id)
			if o then
				o:set_relation(game_object.enemy, db.actor)
				ids[#ids + 1] = o
			end
		end
		if #ids == 0 then return false, "no stalker came online" end
		local mags0 = {}
		for i, o in ipairs(ids) do
			local w = o:active_item()
			mags0[i] = w and w:get_ammo_in_magazine() or -1
		end
		local d0 = dist3(ids[1]:position(), db.actor:position())
		local fired, moved = false, false
		local hits0 = counter.hits
		for k = 1, 30 do
			H.pause(1000)
			for i, o in ipairs(ids) do
				if o:alive() then
					local w = o:active_item()
					if w and mags0[i] >= 0 and w:get_ammo_in_magazine() < mags0[i] then fired = true end
				end
			end
			if math.abs(dist3(ids[1]:position(), db.actor:position()) - d0) > 4 then moved = true end
			if fired and moved then break end
		end
		for _, o in ipairs(ids) do if o:alive() then o:kill(db.actor) end end
		H.pause(800)
		H.god(false)
		return fired, string.format("two bandits %.0f m away after 3 s: shots fired %s, they moved %s, %d hits reported on the actor", d0, tostring(fired), tostring(moved), counter.hits - hits0)
	end)

	-- the actor shoots back: a stalker hit by the actor goes down
	C.run("stalkers", "return-fire", function()
		H.god(true)
		local a = spawn_at("sim_default_bandit_2", 15, 0.4)
		H.pause(3500)
		local o = a and level.object_by_id(a.id)
		if not o then return false, "no stalker came online" end
		o:set_relation(game_object.enemy, db.actor)
		local hp0 = o.health
		local rifle = db.actor:object("wpn_ak74u")
		if rifle then
			db.actor:make_item_active(rifle)
			H.pause(3500)
		end
		local w = db.actor:active_item()
		local mag0 = w and w:get_ammo_in_magazine() or -1
		for round = 1, 12 do
			H.fire_burst(o, 1200)
			H.pause(300)
			if not o:alive() or o.health < hp0 - 0.05 then break end
			if w and w:get_ammo_in_magazine() == 0 then
				H.press(key_bindings.kWPN_RELOAD, 100)
				H.pause(4000)
			end
		end
		H.god(false)
		local w1 = db.actor:active_item()
		return not o:alive() or o.health < hp0, string.format("bandit health %.2f -> %.2f (alive %s), %s in hand, magazine %s -> %s, %.0f m apart", hp0, o.health, tostring(o:alive()), tostring(w1 and w1:section()), tostring(mag0), tostring(w1 and w1:get_ammo_in_magazine()), o:position():distance_to(db.actor:position()))
	end)

	-- two factions at war: the bandit and the stalker engage each other without the actor
	C.run("stalkers", "faction-war", function()
		H.god(true)
		local a = spawn_at("sim_default_bandit_0", 25, 2.0)
		local b = spawn_at("sim_default_stalker_0", 28, 2.0)
		H.pause(3500)
		local oa, ob = a and level.object_by_id(a.id), b and level.object_by_id(b.id)
		if not (oa and ob) then return false, "stalkers did not come online" end
		local seen = false
		local t_end = time_global() + 40000
		while time_global() < t_end do
			H.pause(1000)
			local be = oa:best_enemy()
			-- the bandit has picked an enemy that is not the actor (the stalker, or another one of that faction around), or one has died
			if (be and be:id() ~= db.actor:id()) or not oa:alive() or not ob:alive() then seen = true break end
		end
		local res = string.format("bandit alive %s, stalker alive %s, bandit enemy %s", tostring(oa:alive()), tostring(ob:alive()), tostring(oa:best_enemy() and oa:best_enemy():name()))
		if oa:alive() then oa:kill(db.actor) end
		if ob:alive() then ob:kill(db.actor) end
		H.god(false)
		return seen, res
	end)
	return C.done("chk_stalkers")
end


-- emission and psi storm ---------------------------------------------------------------------------------------------------------
-- A cover is a restrictor zone of misc\surge_manager.ltx; the zones exist only on the level the actor is on.
local function find_cover()
	local sm = surge_manager.get_surge_manager()
	sm:init_surge_covers()
	local names = {}
	for name in pairs(sm.covers or {}) do names[#names + 1] = name end
	table.sort(names)
	for _, name in ipairs(names) do
		local z = db.zone_by_name[name]
		if z then return name, z, #names end
	end
	return nil, nil, #names
end

local function find_open_spot()
	local sm = surge_manager.get_surge_manager()
	local zones = {}
	for name in pairs(sm.covers or {}) do
		local z = db.zone_by_name[name]
		if z then zones[#zones + 1] = z:position() end
	end
	local best, best_d = nil, -1
	for _, p in ipairs(C.level_points()) do
		if not sm:pos_in_cover(p.pos) then
			local nearest = 1e9
			for _, zp in ipairs(zones) do nearest = math.min(nearest, zp:distance_to(p.pos)) end
			if nearest > best_d then best, best_d = p.pos, nearest end
		end
	end
	return best, best_d
end

local function run_event(kind, in_cover)
	start_quiet()
	H.god(false)
	db.actor.health = 1
	local sm = surge_manager.get_surge_manager()
	local pm = psi_storm_manager.get_psi_storm_manager()
	local mgr = (kind == "emission") and sm or pm
	local is_started = (kind == "emission") and surge_manager.is_started or psi_storm_manager.is_started
	local is_finished = (kind == "emission") and surge_manager.is_finished or psi_storm_manager.is_finished
	local sys = kind
	local item = in_cover and "cover" or "open"

	local name, zone, n_covers = find_cover()
	C.check(sys, item .. "/covers", n_covers > 0, string.format("%d cover zones in surge_manager.ltx, first one on this level: %s", n_covers, tostring(name)))
	if in_cover then
		if not zone then return C.done("chk_" .. kind .. "_" .. item) end
		db.actor:set_actor_position(zone:position())
	else
		local pos, d = find_open_spot()
		if pos then db.actor:set_actor_position(pos) end
		H.say("open spot %s m from the nearest cover zone", tostring(d and math.floor(d)))
	end
	H.pause(4000)
	local inside = sm:pos_in_cover(db.actor:position()) and true or false
	C.check(sys, item .. "/position", inside == in_cover, string.format("actor %s a cover zone (%s)", inside and "inside" or "outside", tostring(name)))

	mgr.started = false
	mgr:start(true)
	C.check(sys, item .. "/start", mgr.started == true and is_started(), string.format("%s started: %s", kind, tostring(mgr.started)))
	local started_at = time_global()
	local cover_seen, wave_seen, dead_at = false, false, nil
	local weather0 = level.get_weather()
	local weather_changed = false
	local t_end = time_global() + 420000
	local last_log = 0
	while time_global() < t_end do
		H.pause(1000)
		if (kind == "emission" and surge_manager.actor_in_cover()) or (kind == "psi_storm" and GetEvent and GetEvent("current_safe_cover")) then cover_seen = true end
		if level.get_weather() ~= weather0 then weather_changed = true end
		if not db.actor:alive() then dead_at = time_global() break end
		if is_finished() and not is_started() then break end
		if time_global() - last_log > 30000 then
			last_log = time_global()
			H.say("%s: %d s in, started %s, in cover %s, weather %s, health %s", kind, math.floor((time_global() - started_at) / 1000), tostring(mgr.started), tostring(cover_seen), tostring(level.get_weather()), tostring(db.actor.health))
		end
	end
	local secs = (time_global() - started_at) / 1000
	C.check(sys, item .. "/duration", secs > 100 or dead_at ~= nil, string.format("lasted %.0f s", secs))
	if in_cover then
		C.check(sys, item .. "/cover-flag", cover_seen, "the game saw the actor in cover")
		C.check(sys, item .. "/survives", db.actor:alive() and is_finished(), string.format("actor alive %s, %s finished %s, health %.2f", tostring(db.actor:alive()), kind, tostring(is_finished()), db.actor.health))
		C.check(sys, item .. "/effects", weather_changed, "weather " .. tostring(weather0) .. " -> " .. tostring(level.get_weather()))
		H.pause(3000)
		C.run(sys, item .. "/screenshot", function() return C.shot("chk_" .. kind .. "_" .. item), "screenshot" end)
		return C.done("chk_" .. kind .. "_" .. item)
	end
	C.check(sys, item .. "/kills", dead_at ~= nil, dead_at and string.format("actor killed after %.0f s in the open", (dead_at - started_at) / 1000) or "the actor survived in the open")
	if dead_at then
		H.finish_game_over()
		return { reload = "last" }
	end
	return C.done("chk_" .. kind .. "_" .. item)
end

local function after_death(name)
	return function()
		H.wait_for("the reload", 240000, H.actor_ready)
		H.enable_ui()
		H.pause(6000)
		C.check("emission", "open/reload-alive", db.actor:alive() and db.actor.health > 0.3, "health " .. C.fmt(db.actor.health))
		return C.done(name)
	end
end

-- weather and the day/night cycle -----------------------------------------------------------------------------------------------------
local function weather_plan()
	start_quiet()
	H.god(true)
	-- the clock: set it, read it back
	level.change_game_time(0, 24, 0) -- move on a day so the sun is known
	H.pause(2000)
	local function set_hour(h)
		local now = level.get_time_hours()
		local add = (h - now) % 24
		level.change_game_time(0, add, 0)
		H.pause(2500)
		return level.get_time_hours()
	end
	local noon = set_hour(12)
	C.check("weather", "set-noon", noon == 12, "hour " .. noon)
	local sun_noon = level.get_sun_intensity()
	C.shot("chk_weather_noon")
	local mid = set_hour(1)
	C.check("weather", "set-night", mid == 1, "hour " .. mid)
	local sun_night = level.get_sun_intensity()
	C.shot("chk_weather_night")
	C.check("weather", "sun-intensity", sun_noon > sun_night, string.format("sun intensity %.3f at noon, %.3f at 1 o'clock", sun_noon, sun_night))
	local pos_noon = set_hour(12)

	-- weather presets: each is applied and read back
	local presets = { "w_clear1", "w_partly1", "w_cloudy1", "w_foggy1", "w_rain1", "w_storm1" }
	local seen = {}
	for _, w in ipairs(presets) do
		C.run("weather", "preset/" .. w, function()
			level.set_weather(w, true)
			H.pause(3500)
			local got = level.get_weather()
			seen[#seen + 1] = got
			if w == "w_rain1" or w == "w_storm1" then C.shot("chk_weather_" .. w) end
			return got == w, "weather " .. tostring(got)
		end)
	end
	level.set_weather("w_clear1", true)
	H.pause(2000)

	-- the clock runs: a game day passes in a minute or so, the hour moves on and the date changes
	local d0 = game.get_game_time()
	local h0 = level.get_time_hours()
	local hours_seen, weather_seen = {}, {}
	local t_end = time_global() + 60000
	local last_sample = 0
	while time_global() < t_end do
		level.set_time_factor(1000)
		coroutine.yield()
		if time_global() - last_sample > 1000 then
			last_sample = time_global()
			hours_seen[level.get_time_hours()] = true
			weather_seen[level.get_weather()] = true
		end
	end
	level.set_time_factor(6)
	local n_hours, n_weathers = 0, 0
	for _ in pairs(hours_seen) do n_hours = n_hours + 1 end
	for _ in pairs(weather_seen) do n_weathers = n_weathers + 1 end
	local advanced = game.get_game_time():diffSec(d0)
	C.check("weather", "cycle-clock", advanced > 20 * 3600 and n_hours >= 12, string.format("%.1f game hours in 60 s, %d different hours seen", advanced / 3600, n_hours))
	C.check("weather", "cycle-weather", n_weathers >= 2, string.format("%d weather presets over the day: %s", n_weathers, (function() local t = {} for k in pairs(weather_seen) do t[#t + 1] = k end return table.concat(t, ",") end)()))
	H.god(false)
	return C.done("chk_weather")
end

-- sleeping -------------------------------------------------------------------------------------------------------------------------------
local function sleep_plan()
	start_quiet()
	local sm = surge_manager.get_surge_manager()
	-- not in a safe place: the game refuses
	local open_pos = find_open_spot_for_sleep and find_open_spot_for_sleep() or nil
	local name, zone = nil, nil
	do
		sm:init_surge_covers()
		for n in pairs(sm.covers) do
			if db.zone_by_name[n] then name, zone = n, db.zone_by_name[n] break end
		end
	end
	-- refuse in the open
	do
		local zones = {}
		for n in pairs(sm.covers) do if db.zone_by_name[n] then zones[#zones + 1] = db.zone_by_name[n]:position() end end
		local best, best_d = nil, -1
		for _, p in ipairs(C.level_points()) do
			if not sm:pos_in_cover(p.pos) then
				local nearest = 1e9
				for _, zp in ipairs(zones) do nearest = math.min(nearest, zp:distance_to(p.pos)) end
				if nearest > best_d then best, best_d = p.pos, nearest end
			end
		end
		if best then db.actor:set_actor_position(best) end
		H.pause(4000)
		ui_sleep_dialog.sleep(false)
		H.pause(2000)
		local shown = ui_sleep_dialog.GUI and ui_sleep_dialog.GUI:IsShown()
		C.check("sleep", "refused-in-the-open", not shown, string.format("%.0f m from any cover: dialog shown %s", best_d, tostring(shown)))
		if shown then ui_sleep_dialog.GUI:Close() end
	end
	-- in a cover zone it opens
	db.actor:set_actor_position(zone:position())
	H.pause(4000)
	H.god(false)
	local v0 = C.vitals()
	local t0 = game.get_game_time()
	local h0 = level.get_time_hours()
	local saves0 = #C.saves("*sleep*.scop")
	ui_sleep_dialog.sleep(false)
	H.pause(2500)
	local shown = ui_sleep_dialog.GUI ~= nil and ui_sleep_dialog.GUI:IsShown()
	C.check("sleep", "dialog", shown, "sleep dialog shown in " .. tostring(name))
	C.run("sleep", "screenshot", function() return C.shot("chk_sleep_dialog"), "screenshot" end)
	if not shown then return C.done("chk_sleep") end
	ui_sleep_dialog.GUI.time_track:SetCurrentValue()
	ui_sleep_dialog.GUI:OnButtonSleep()
	-- the sleep effect runs a few seconds of camera animation, then the game clock jumps
	local woke = H.wait_for("the sleep to end", 90000, function() return not db.actor:has_info("actor_is_sleeping") and game.get_game_time():diffSec(t0) > 3600 end)
	H.pause(2500)
	local slept = game.get_game_time():diffSec(t0) / 3600
	local v1 = C.vitals()
	C.check("sleep", "time-passes", woke and slept >= 1, string.format("%.1f game hours passed, hour %d -> %d", slept, h0, level.get_time_hours()))
	C.check("sleep", "rested", v1.power >= 0.99 and (v1.sleepiness or 0) <= (v0.sleepiness or 1), string.format("sleepiness %s -> %s, power %s", C.fmt(v0.sleepiness), C.fmt(v1.sleepiness), C.fmt(v1.power)))
	C.check("sleep", "hungrier", v1.satiety < v0.satiety, string.format("satiety %.4f -> %.4f", v0.satiety, v1.satiety))
	C.check("sleep", "thirstier", (v1.thirst or 0) > (v0.thirst or 0), string.format("thirst %s -> %s", C.fmt(v0.thirst), C.fmt(v1.thirst)))
	C.check("sleep", "autosave", C.save_exists("player - sleep") ~= nil, "the sleep save: " .. tostring(C.save_exists("player - sleep") ~= nil))
	C.check("sleep", "ui-back", db.actor:alive() and not H.ui_open(), "the HUD is back, the actor is alive")
	-- forced sleep (the "you cannot stay awake" path)
	local t1 = game.get_game_time()
	ui_sleep_dialog.sleep_forced(4)
	local woke2 = H.wait_for("the forced sleep to end", 90000, function() return not db.actor:has_info("actor_is_sleeping") and game.get_game_time():diffSec(t1) >= 3 * 3600 end)
	H.pause(2000)
	C.check("sleep", "forced", woke2 and db.actor:alive(), string.format("%.1f game hours passed", game.get_game_time():diffSec(t1) / 3600))
	return C.done("chk_sleep")
end

function plans(c, h)
	C, H = c, h
	local out = {}
	out.chk_alife = { alife_plan }
	out.chk_mutants = { mutants_plan }
	out.chk_stalkers = { stalkers_plan }
	out.chk_emission_cover = { function() return run_event("emission", true) end }
	out.chk_emission_open = { function() return run_event("emission", false) end, after_death("chk_emission_open") }
	out.chk_weather = { weather_plan }
	out.chk_sleep = { sleep_plan }
	out.chk_psistorm_cover = { function() return run_event("psi_storm", true) end }
	return out
end
