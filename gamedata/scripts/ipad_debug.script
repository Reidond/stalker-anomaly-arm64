-- Test helpers for the iPad port (docs/ios-port/IPAD.md). With -dbg on the command line the console has `run_string`:
--   run_string ipad_debug.dump_smarts()        logs the actor's position and every smart terrain's position (lines ACTORPOS / SMART)
--   run_string ipad_debug.tp(x, y, z)          teleports the actor
-- Nothing in the game calls this file.

function dump_smarts()
	local p = db.actor:position()
	printf("%s", string.format("ACTORPOS %.1f %.1f %.1f %s", p.x, p.y, p.z, level.name()))
	alife():iterate_objects(function(se)
		if se and se:clsid() == clsid.smart_terrain and string.find(se:name(), "^esc_") then
			local q = se.position
			printf("%s", string.format("SMART %s %.1f %.1f %.1f", se:name(), q.x, q.y, q.z))
		end
	end)
end

function tp(x, y, z)
	db.actor:set_actor_position(vector():set(x, y, z))
end

-- Puts items into the actor's inventory (`run_string ipad_debug.give("wpn_ak74")`) ...
function give(section, count)
	local a = db.actor
	for i = 1, (count or 1) do
		alife():create(section, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id())
	end
end

function give_ammo(section, count)
	local a = db.actor
	alife():create_ammo(section, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id(), count)
end

-- ... and puts the rifle into slot 3 (1 knife, 2 pistol, 3 primary weapon) and draws it, so a save made afterwards has it in hand. Logs SLOT lines.
function equip()
	local a = db.actor
	local function slot(section, n)
		local o = a:object(section)
		printf("%s", "SLOT find " .. section .. " " .. tostring(o ~= nil))
		if o then
			local ok, err = pcall(function() a:move_to_slot(o, n) end)
			printf("%s", "SLOT move " .. section .. " -> " .. n .. " " .. tostring(ok) .. " " .. tostring(err))
		end
	end
	slot("wpn_ak74", 3)
	slot("device_pda_1", 8)    -- a start made by script leaves the PDA and the outfit in the backpack
	slot("novice_outfit", 7)
	slot("helm_resp", 12)
	slot("device_torch", 10)
	for n = 1, 3 do
		local o = a:item_in_slot(n)
		printf("%s", "SLOT " .. n .. " holds " .. (o and o:section() or "nothing"))
	end
	local ok, err = pcall(function() a:activate_slot(3) end)
	printf("%s", "SLOT activate_slot " .. tostring(ok) .. " " .. tostring(err))
end

-- Two lines of state for the log: position, the item in hand and its magazine (STATE), the view and what the pad actions change (VIEW).
function state(tag)
	local a = db.actor
	local p = a:position()
	local item = a:active_item()
	local slot = a:active_slot()
	local s = string.format("STATE %s pos %.1f %.1f %.1f item %s ammo %s slot %s", tag or "", p.x, p.y, p.z,
		item and item:section() or "none", item and tostring(item:get_ammo_in_magazine()) or "-", tostring(slot))
	printf("%s", s)
	-- what the pad actions change besides that: the view, the eye height (crouch, jump), the field of view (aiming), the torch,
	-- night vision, health; the dialog that has the input
	local ok, extra = pcall(function()
		local d = device()
		local dir = d.cam_dir
		local cp = d.cam_pos
		local top = d.cam_top
		local dialogs = "paused" .. (device():is_paused() and "1" or "0") -- which dialog is up: the `pad ui: dialog up / closed` lines of pad_feedback_log
		return string.format("VIEW %s yaw %.1f pitch %.1f eye %.2f fov %.1f roll %.3f torch %s nv %s health %.2f %s",
			tag or "", math.deg(math.atan2(dir.x, dir.z)), math.deg(math.asin(math.max(-1, math.min(1, dir.y)))), cp.y - p.y,
			d.fov, top.x, tostring(a:torch_enabled()), tostring(a:night_vision_enabled()), a.health, dialogs)
	end)
	printf("%s", ok and extra or ("VIEW error " .. tostring(extra)))
end

-- Logs what the actor carries (INV lines)
function list_inventory()
	local n = 0
	db.actor:iterate_inventory(function(owner, item)
		n = n + 1
		printf("%s", "INV " .. item:section())
	end, db.actor)
	printf("%s", "INV count " .. n)
end

-- Checks the UI colour helpers (COLOR lines)
function color_test()
	local c = GetARGB(255, 216, 186, 140)
	printf("%s", string.format("COLOR GetARGB(255,216,186,140) = %d (%08x) A=%d R=%d G=%d B=%d", c, c, ClrGetA(c), ClrGetR(c), ClrGetG(c), ClrGetB(c)))
end

-- Logs which item is in each inventory slot (SLOTS line), and puts the PDA into slot 8 when it is not there
function slots(fix)
	local a = db.actor
	local parts = {}
	for n = 1, 12 do
		local o = a:item_in_slot(n)
		parts[#parts + 1] = n .. "=" .. (o and o:section() or "-")
	end
	printf("%s", "SLOTS " .. table.concat(parts, " "))
	if fix then
		local pda = a:object("device_pda_1")
		if pda then
			local ok, err = pcall(function() a:move_to_slot(pda, 8) end)
			printf("%s", "SLOTS moved pda " .. tostring(ok) .. " " .. tostring(err))
		end
	end
end

-- Logs how a string table id translates (`run_string ipad_debug.tr("ui_mm_quit")`): an unknown id comes back as itself.
function tr(id)
	printf("%s", "TR " .. id .. " = " .. game.translate_string(id))
end

-- Sets the actor's health (0..1), to see a medkit work.
function hurt(h)
	db.actor.health = h
end

-- Moves the actor next to the Cordon trader (TRADER lines), so a script can open the talk and trade windows.
function to_trader()
	local id = get_story_object_id("esc_m_trader")
	local se = id and alife():object(id)
	if not se then
		printf("%s", "TRADER not found")
		return
	end
	local p = se.position
	printf("%s", string.format("TRADER %s at %.1f %.1f %.1f", se:name(), p.x, p.y, p.z))
	db.actor:set_actor_position(vector():set(p.x, p.y, p.z + 1.5))
end

-- Starts the conversation with the trader once he is online (the dialog window opens).
function talk_trader()
	local npc = get_story_object("esc_m_trader")
	printf("%s", "TALK " .. (npc and npc:name() or "trader offline"))
	if npc then
		db.actor:run_talk_dialog(npc, false)
	end
end

-- Hits the actor (power 0..1 of the health bar, wound by default): `run_string ipad_debug.hit(0.4)`; with god mode off the health drops.
function hit_actor(power)
	local h = hit()
	h.power = power
	h.impulse = 0
	h.direction = vector():set(0, 0, 1)
	h.draftsman = db.actor
	h.type = hit.wound
	db.actor:hit(h)
end

-- Puts an item on the ground a step in front of the actor (to pick up with the Use button): `run_string ipad_debug.drop_ahead("bandage")`.
function drop_ahead(section)
	local a = db.actor
	local d = device().cam_dir
	local p = a:position()
	local at = vector():set(p.x + d.x * 1.2, p.y, p.z + d.z * 1.2)
	alife():create(section, at, a:level_vertex_id(), a:game_vertex_id())
end

-- How many items of a section the actor carries (COUNT line).
function count(section)
	local n = 0
	db.actor:iterate_inventory(function(owner, item)
		if item:section() == section then n = n + 1 end
	end, db.actor)
	printf("%s", "COUNT " .. section .. " " .. n)
end
